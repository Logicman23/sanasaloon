# Copy this file to .env.local and fill in your Supabase project values
# (Supabase Dashboard -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Used by the POS to record sales. Never expose this to the browser
# (no NEXT_PUBLIC_ prefix) and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only PIN a manager enters to authorise POS discounts (6+ digits recommended).
ADMIN_OVERRIDE_PIN=
